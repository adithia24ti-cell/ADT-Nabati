<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar kotak -->
    <solid android:color="@color/white" />

    <!-- Garis tepi tipis kuning keju -->
    <stroke
        android:width="1dp"
        android:color="@color/kuning_nabati" />

    <!-- Sudut membulat seperti kartu di grand design -->
    <corners android:radius="16dp" />

    <!-- Jarak isi ke tepi kotak -->
    <padding
        android:left="12dp"
        android:top="12dp"
        android:right="12dp"
        android:bottom="12dp" />
</shape>
