<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Beranda.BerandaFragment">

    <!-- Header gelombang, ditulis pertama agar berada di belakang Toolbar dan isi -->
    <View
        android:id="@+id/bgHeaderBeranda"
        android:layout_width="0dp"
        android:layout_height="260dp"
        android:background="@drawable/bg_header_gelombang"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header, batas harian, dan grid produk -->
    <ScrollView
        android:id="@+id/scrollBeranda"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Logo dan judul aplikasi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/merah_nabati"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="20dp">

                    <ImageView
                        android:id="@+id/imgLogo"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/logo_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/textJudulApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/app_title"
                        android:textSize="30sp"
                        android:textColor="@color/white"
                        android:fontFamily="@font/baloo2_extrabold"
                        app:layout_constraintTop_toTopOf="@id/imgLogo"
                        app:layout_constraintStart_toEndOf="@id/imgLogo"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/textTagline"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/app_tagline"
                        android:textSize="13sp"
                        android:textColor="@color/kuning_nabati"
                        android:fontFamily="@font/jakarta_bold"
                        app:layout_constraintTop_toBottomOf="@id/textJudulApp"
                        app:layout_constraintStart_toStartOf="@id/textJudulApp"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textBatasJudul"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/label_batas_harian"
                android:textSize="16sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/jakarta_bold" />

            <!-- Tiga tombol batas harian Kemenkes dalam 3 kolom sama lebar -->
            <androidx.gridlayout.widget.GridLayout
                android:id="@+id/gridBatas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:columnCount="3"
                app:useDefaultMargins="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatasGula"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_gula"
                    android:textSize="13sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    android:backgroundTint="@color/kuning_nabati"
                    app:cornerRadius="16dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatasNatrium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_natrium"
                    android:textSize="13sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    android:backgroundTint="@color/kuning_nabati"
                    app:cornerRadius="16dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBatasLemak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/grid_lemak"
                    android:textSize="13sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    android:backgroundTint="@color/kuning_nabati"
                    app:cornerRadius="16dp"
                    app:layout_columnWeight="1"
                    app:layout_gravity="fill_horizontal" />

            </androidx.gridlayout.widget.GridLayout>

            <TextView
                android:id="@+id/textSapaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/label_sapaan"
                android:textSize="22sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/baloo2_extrabold" />

            <TextView
                android:id="@+id/textPilihProduk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_pilih_produk"
                android:textSize="14sp"
                android:textColor="@color/abu_gelap"
                android:fontFamily="@font/jakarta_regular" />

            <!-- Grid produk 2 kolom, diisi ProdukGridAdapter -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProduk"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />

            <!-- Tombol ke halaman Katalog Produk -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKatalog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_katalog"
                android:textColor="@color/white"
                android:fontFamily="@font/jakarta_bold"
                android:backgroundTint="@color/merah_nabati"
                app:cornerRadius="20dp" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
