<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Jelajah.JelajahFragment">

    <TextView
        android:id="@+id/textJelajahJudul"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:text="@string/jelajah_judul"
        android:textSize="22sp"
        android:textColor="@color/tinta"
        android:fontFamily="@font/baloo2_extrabold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textJelajahSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/jelajah_sub"
        android:textSize="14sp"
        android:textColor="@color/abu_gelap"
        android:fontFamily="@font/jakarta_regular"
        app:layout_constraintTop_toBottomOf="@id/textJelajahJudul"
        app:layout_constraintStart_toStartOf="@id/textJelajahJudul"
        app:layout_constraintEnd_toEndOf="@id/textJelajahJudul" />

    <!-- Card + Tombol ke halaman WebView -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWeb"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/textJelajahSub"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/kuning_nabati"
        app:cardElevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp">

            <TextView
                android:id="@+id/textWebTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/web_card_title"
                android:textSize="18sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/baloo2_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textWebDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/web_card_desc"
                android:textSize="13sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/jakarta_regular"
                app:layout_constraintTop_toBottomOf="@id/textWebTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnWebView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_web_view"
                android:textColor="@color/white"
                android:fontFamily="@font/jakarta_bold"
                android:backgroundTint="@color/merah_nabati"
                app:icon="@drawable/ic_web"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/textWebDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
