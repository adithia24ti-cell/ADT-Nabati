<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Logo + Judul Aplikasi -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/merah_nabati"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="20dp">

                <ImageView
                    android:id="@+id/imgLogo"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/logo_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/textJudulApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/app_title"
                    android:textSize="30sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/baloo2_extrabold"
                    app:layout_constraintTop_toTopOf="@id/imgLogo"
                    app:layout_constraintStart_toEndOf="@id/imgLogo"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/textTagline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/app_tagline"
                    android:textSize="13sp"
                    android:textColor="@color/kuning_nabati"
                    android:fontFamily="@font/jakarta_bold"
                    app:layout_constraintTop_toBottomOf="@id/textJudulApp"
                    app:layout_constraintStart_toStartOf="@id/textJudulApp"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/textSapaan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_sapaan"
            android:textSize="22sp"
            android:textColor="@color/tinta"
            android:fontFamily="@font/baloo2_extrabold" />

        <TextView
            android:id="@+id/textPilihProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_pilih_produk"
            android:textSize="14sp"
            android:textColor="@color/abu_gelap"
            android:fontFamily="@font/jakarta_regular" />

        <!-- Card: nama_richeese -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRicheese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRicheese"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/nabati_richeese"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRicheese"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_richeese"
                    android:textSize="16sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    app:layout_constraintTop_toTopOf="@id/img_cardRicheese"
                    app:layout_constraintStart_toEndOf="@id/img_cardRicheese"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRicheese"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_richeese"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    android:fontFamily="@font/jakarta_regular"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRicheese"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRicheese"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card: nama_richoco -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRichoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRichoco"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/nabati_richoco"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRichoco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_richoco"
                    android:textSize="16sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    app:layout_constraintTop_toTopOf="@id/img_cardRichoco"
                    app:layout_constraintStart_toEndOf="@id/img_cardRichoco"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRichoco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_richoco"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    android:fontFamily="@font/jakarta_regular"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRichoco"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRichoco"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card: nama_rolls -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRolls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/white"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRolls"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/nabati_rolls"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRolls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_rolls"
                    android:textSize="16sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_bold"
                    app:layout_constraintTop_toTopOf="@id/img_cardRolls"
                    app:layout_constraintStart_toEndOf="@id/img_cardRolls"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRolls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_rolls"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    android:fontFamily="@font/jakarta_regular"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRolls"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRolls"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card + Tombol ke halaman WebView -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWeb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:backgroundTint="@color/kuning_nabati"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp">

                <TextView
                    android:id="@+id/textWebTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/web_card_title"
                    android:textSize="18sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/baloo2_extrabold"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/textWebDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/web_card_desc"
                    android:textSize="13sp"
                    android:textColor="@color/tinta"
                    android:fontFamily="@font/jakarta_regular"
                    app:layout_constraintTop_toBottomOf="@id/textWebTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <Button
                    android:id="@+id/btnWebView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/btn_web_view"
                    android:textColor="@color/white"
                    android:fontFamily="@font/jakarta_bold"
                    android:backgroundTint="@color/merah_nabati"
                    app:icon="@drawable/ic_web"
                    app:iconGravity="textStart"
                    app:layout_constraintTop_toBottomOf="@id/textWebDesc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>