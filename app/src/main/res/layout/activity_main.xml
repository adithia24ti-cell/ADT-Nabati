<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/textJudulApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:text="@string/app_title"
            android:textStyle="bold"
            android:textSize="28sp"
            android:textColor="@color/merah_nabati"
            android:fontFamily="@font/montserrat_black" />

        <TextView
            android:id="@+id/textSubjudul"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/app_subtitle"
            android:textSize="16sp"
            android:textColor="@color/abu_gelap" />

        <TextView
            android:id="@+id/textPilihProduk"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/label_pilih_produk"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/black"
            android:fontFamily="@font/montserrat_black" />

        <!-- Card: nama_richeese -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRicheese"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRicheese"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/nama_richeese"
                    android:src="@drawable/nabati_richeese"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRicheese"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_richeese"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/img_cardRicheese"
                    app:layout_constraintStart_toEndOf="@id/img_cardRicheese"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRicheese"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_richeese"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRicheese"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRicheese"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card: nama_richoco -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRichoco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRichoco"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/nama_richoco"
                    android:src="@drawable/nabati_richoco"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRichoco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_richoco"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/img_cardRichoco"
                    app:layout_constraintStart_toEndOf="@id/img_cardRichoco"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRichoco"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_richoco"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRichoco"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRichoco"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Card: nama_rolls -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRolls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clickable="true"
            android:focusable="true"
            android:backgroundTint="@color/white"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <ImageView
                    android:id="@+id/img_cardRolls"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/nama_rolls"
                    android:src="@drawable/nabati_rolls"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/nama_cardRolls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/nama_rolls"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintTop_toTopOf="@id/img_cardRolls"
                    app:layout_constraintStart_toEndOf="@id/img_cardRolls"
                    app:layout_constraintEnd_toEndOf="parent" />

                <TextView
                    android:id="@+id/info_cardRolls"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/info_rolls"
                    android:textSize="13sp"
                    android:textColor="@color/abu_gelap"
                    app:layout_constraintTop_toBottomOf="@id/nama_cardRolls"
                    app:layout_constraintStart_toStartOf="@id/nama_cardRolls"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>