<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kuning_nabati"
    tools:context=".Onboarding.OnboardGiziFragment">

    <ImageView
        android:id="@+id/imgOnboard"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:contentDescription="@string/onboard_gizi_judul"
        android:scaleType="centerCrop"
        android:src="@drawable/logo_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.28" />

    <TextView
        android:id="@+id/textJudulOnboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:text="@string/onboard_gizi_judul"
        android:textSize="26sp"
        android:textColor="@color/tinta"
        android:fontFamily="@font/baloo2_extrabold"
        app:layout_constraintTop_toBottomOf="@id/imgOnboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/textDescOnboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        android:gravity="center"
        android:text="@string/onboard_gizi_desc"
        android:textSize="15sp"
        android:textColor="@color/tinta"
        android:fontFamily="@font/jakarta_regular"
        app:layout_constraintTop_toBottomOf="@id/textJudulOnboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
