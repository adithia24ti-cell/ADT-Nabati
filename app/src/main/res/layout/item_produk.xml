<?xml version="1.0" encoding="utf-8"?>
<!-- Satu baris produk di ListView Katalog -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_rounded_container">

        <ImageView
            android:id="@+id/imgProduk"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:contentDescription="@string/desc_gambar_produk"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/textNamaProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:textSize="16sp"
            android:textColor="@color/tinta"
            android:fontFamily="@font/jakarta_bold"
            app:layout_constraintStart_toEndOf="@id/imgProduk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/imgProduk" />

        <TextView
            android:id="@+id/textInfoProduk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="@color/abu_gelap"
            android:fontFamily="@font/jakarta_regular"
            app:layout_constraintStart_toStartOf="@id/textNamaProduk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textNamaProduk" />

        <TextView
            android:id="@+id/textPersenGula"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:fontFamily="@font/jakarta_bold"
            app:layout_constraintStart_toStartOf="@id/textNamaProduk"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textInfoProduk" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
