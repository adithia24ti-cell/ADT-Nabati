<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Akun.AkunFragment">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/krem"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Header merah melengkung, ditulis pertama agar berada di belakang Toolbar dan card -->
            <View
                android:id="@+id/bgHeaderAkun"
                android:layout_width="0dp"
                android:layout_height="170dp"
                android:background="@drawable/bg_header_lengkung"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="0dp"
                android:layout_height="?attr/actionBarSize"
                android:background="?attr/colorPrimary"
                app:titleTextColor="@android:color/white"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Card profil developer dan logout -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAkun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintTop_toBottomOf="@id/toolbar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:backgroundTint="@color/white"
                app:cardElevation="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="18dp">

                    <TextView
                        android:id="@+id/textAkunTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/akun_title"
                        android:textSize="18sp"
                        android:textColor="@color/tinta"
                        android:fontFamily="@font/baloo2_extrabold"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <TextView
                        android:id="@+id/textAkunDesc"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:textColor="@color/abu_gelap"
                        android:fontFamily="@font/jakarta_regular"
                        app:layout_constraintTop_toBottomOf="@id/textAkunTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <Button
                        android:id="@+id/btnProfil"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginEnd="6dp"
                        android:text="@string/btn_profil"
                        android:textColor="@color/tinta"
                        android:fontFamily="@font/jakarta_bold"
                        android:backgroundTint="@color/kuning_nabati"
                        app:icon="@drawable/ic_person"
                        app:iconTint="@color/tinta"
                        app:iconGravity="textStart"
                        app:layout_constraintTop_toBottomOf="@id/textAkunDesc"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/btnLogout" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/btn_logout"
                        android:textColor="@color/white"
                        android:fontFamily="@font/jakarta_bold"
                        android:backgroundTint="@color/merah_nabati"
                        app:icon="@drawable/ic_logout"
                        app:iconGravity="textStart"
                        app:layout_constraintTop_toTopOf="@id/btnProfil"
                        app:layout_constraintStart_toEndOf="@id/btnProfil"
                        app:layout_constraintEnd_toEndOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textMenuAkun"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="@string/label_menu_akun"
                android:textSize="18sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/baloo2_extrabold"
                app:layout_constraintTop_toBottomOf="@id/cardAkun"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Daftar menu akun, diisi SimpleAdapter dengan layout simple_list_item_2 -->
    <ListView
        android:id="@+id/listMenuAkun"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
