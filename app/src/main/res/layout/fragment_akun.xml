<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Akun.AkunFragment">

    <!-- Toolbar Fragment (cukup ConstraintLayout, tanpa CoordinatorLayout) -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card Akun: Profil Developer + Logout -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardAkun"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:backgroundTint="@color/white"
        app:cardElevation="4dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="18dp">

            <TextView
                android:id="@+id/textAkunTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/akun_title"
                android:textSize="18sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/baloo2_extrabold"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/textAkunDesc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/abu_gelap"
                android:fontFamily="@font/jakarta_regular"
                app:layout_constraintTop_toBottomOf="@id/textAkunTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <Button
                android:id="@+id/btnProfil"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="6dp"
                android:text="@string/btn_profil"
                android:textColor="@color/tinta"
                android:fontFamily="@font/jakarta_bold"
                android:backgroundTint="@color/kuning_nabati"
                app:icon="@drawable/ic_person"
                app:iconTint="@color/tinta"
                app:iconGravity="textStart"
                app:layout_constraintTop_toBottomOf="@id/textAkunDesc"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnLogout" />

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/btn_logout"
                android:textColor="@color/white"
                android:fontFamily="@font/jakarta_bold"
                android:backgroundTint="@color/merah_nabati"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:layout_constraintTop_toTopOf="@id/btnProfil"
                app:layout_constraintStart_toEndOf="@id/btnProfil"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
