<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    tools:context=".Beranda.SnackDetailActivity">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:titleTextColor="@android:color/white"
            app:subtitleTextColor="@android:color/white"
            app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="24dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/imgSnack"
                android:layout_width="220dp"
                android:layout_height="220dp" />

            <TextView
                android:id="@+id/textNamaSnack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="26sp"
                android:textColor="@color/merah_nabati"
                android:fontFamily="@font/baloo2_extrabold" />

            <TextView
                android:id="@+id/textProdusen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/snack_produsen"
                android:textSize="13sp"
                android:textColor="@color/abu_gelap"
                android:fontFamily="@font/jakarta_regular" />

            <TextView
                android:id="@+id/textDeskripsi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:textColor="@color/tinta"
                android:fontFamily="@font/jakarta_regular" />

            <!-- MaterialCardView tabel gizi -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGizi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/white"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textJudulGizi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingVertical="10dp"
                        android:paddingHorizontal="16dp"
                        android:background="@color/kuning_nabati"
                        android:text="@string/judul_gizi"
                        android:textSize="18sp"
                        android:textColor="@color/tinta"
                        android:fontFamily="@font/baloo2_extrabold" />

                    <TableLayout
                        android:id="@+id/tabelGizi"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="8dp">

                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_takaran"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valTakaran" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_energi"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valEnergi" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_lemak"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valLemak" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_protein"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valProtein" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_karbo"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valKarbo" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_gula"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valGula" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                        <TableRow android:paddingVertical="6dp">
                            <TextView android:layout_width="0dp" android:layout_weight="1"
                                android:layout_height="wrap_content" android:text="@string/label_natrium"
                                android:fontFamily="@font/jakarta_regular"
                                android:textColor="@color/abu_gelap" android:textSize="15sp" />
                            <TextView android:id="@+id/valNatrium" android:layout_width="wrap_content"
                                android:layout_height="wrap_content" android:text="-"
                                android:fontFamily="@font/jakarta_bold"
                                android:textColor="@color/tinta" android:textSize="15sp"
                                android:gravity="end" />
                        </TableRow>
                    </TableLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/textCatatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/catatan_gizi"
                android:textSize="12sp"
                android:textColor="@color/abu_gelap"
                android:fontFamily="@font/jakarta_regular" />

            <Button
                android:id="@+id/btnCatat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingVertical="12dp"
                android:text="@string/btn_catat"
                android:textColor="@color/white"
                android:fontFamily="@font/jakarta_bold"
                android:backgroundTint="@color/merah_nabati" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>